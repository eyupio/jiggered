# Copy to .env and fill in.
APP_USERNAME=paul

# Recommended: a bcrypt hash. Generate with:
#   docker compose run --rm jiggered hash 'your-password'
# Wrap it in single quotes, because bcrypt hashes contain $ signs.
APP_PASSWORD_HASH='$2a$12$replace.this.with.your.hash'

# Or a plain password (min 8 chars). Use one or the other.
# APP_PASSWORD=change-me-please

# Cookies are Secure (HTTPS only) by default. Set to false only for local HTTP testing.
APP_SECURE_COOKIE=true

# Set true when running behind your own reverse proxy, so login rate limiting sees real client IPs.
APP_TRUST_PROXY=true
