# Nothing here is required for a personal install. Jiggered keeps its settings and accounts in the database.
# Deployment variables control the database, listen address and public-site indexing:
# APP_DB=/data/jiggered.db
# APP_ADDR=:8080

# Public pages are indexed by default once a public origin is known: set the Public application URL in
# Admin, or APP_PUBLIC_ORIGIN below. Admin also has an opt-out. These variables are optional overrides;
# APP_PUBLIC_INDEXING=false forces noindex (use it on previews). Restart after changing them.
# APP_PUBLIC_ORIGIN=https://your-official-host.example
# APP_PUBLIC_INDEXING=true

# Image tag to run: latest = newest release (v* tag), dev = newest push to main. (Read by docker compose.)
JIGGERED_TAG=latest

# Set up an install with:
#   docker compose up -d
#   docker compose exec jiggered /jiggered user add NAME --admin
#
# Variables from earlier versions of Jiggered (APP_USERNAME, APP_PASSWORD_HASH, APP_PASSWORD, APP_SECURE_COOKIE,
# APP_TRUST_PROXY, APP_PROXY_HOPS, APP_TRUSTED_PROXY_CIDRS) still work, but only as a one-time seed for what the database doesn't have yet.
# After the first start the database wins, so you can delete them. See "Configuration" in the README.


# Optional one-time seed: only actual proxy source ranges, never arbitrary clients.
# APP_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
