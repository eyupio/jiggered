# Copy to .env and fill in.
# Image tag to run: latest = newest release (v* tag), dev = newest push to main.
JIGGERED_TAG=latest

# The first admin. These two are used once, to create that account when the database has no accounts yet
# (an existing single-user database is taken over by it). After that, accounts live in the app: people change
# their own password in Account, and the admin adds the rest from the Admin tab or with
#   docker compose exec jiggered /jiggered user add NAME
APP_USERNAME=paul

# Recommended: a bcrypt hash. Generate with:
#   docker compose run --rm jiggered hash 'your-password'
# Wrap it in single quotes, because bcrypt hashes contain $ signs.
APP_PASSWORD_HASH='$2a$12$replace.this.with.your.hash'

# Or a plain password (min 8 chars). Use one or the other.
# APP_PASSWORD=change-me-please

# Cookies are Secure (HTTPS only) by default. Set to false only for local HTTP testing.
APP_SECURE_COOKIE=true

# Set true when running behind your own reverse proxy, so sign-in lockouts and the device list see real client
# addresses. The address is read from the right-hand end of X-Forwarded-For (the entry your proxy added).
APP_TRUST_PROXY=true
# How many proxies sit in front of Jiggered. Leave at 1 for a single reverse proxy (Caddy, nginx, Traefik).
# APP_PROXY_HOPS=1
