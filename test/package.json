{
  "name": "jiggered-development",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "test": "node --test \"*.test.mjs\"",
    "browser": "node support/run-browser.cjs",
    "browser:install": "playwright install chromium",
    "format": "prettier --write --ignore-path ../.prettierignore ../web . ../.github ../CONTRIBUTING.md ../AGENTS.md ../CLAUDE.md ../README.md ../.prettierrc.json",
    "format:check": "prettier --check --ignore-path ../.prettierignore ../web . ../.github ../CONTRIBUTING.md ../AGENTS.md ../CLAUDE.md ../README.md ../.prettierrc.json",
    "lint": "cd .. && test/node_modules/.bin/eslint --config test/eslint.config.mjs web test",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9"
  }
}
