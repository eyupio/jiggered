# Sidecar only: never reuse Jiggered's health-log/database credentials.
AI_CONTEXT_REPOSITORY=jnnngs/jiggered
AI_CONTEXT_BASE_URL=https://context.example.com
AI_CONTEXT_ALLOWED_USERS=jnnngs
# Fine-grained GitHub PAT: only this repository, Contents: Read-only.
AI_CONTEXT_GITHUB_TOKEN=
# GitHub OAuth App callback: https://context.example.com/auth/callback
AI_CONTEXT_OAUTH_CLIENT_ID=
AI_CONTEXT_OAUTH_CLIENT_SECRET=
# Exact MCP-client callback URLs shown when configuring the connectors.
# Examples are not assumed: verify the current Claude/ChatGPT callback URLs.
AI_CONTEXT_CLIENT_REDIRECT_URIS=
# Generate separately with secrets.token_urlsafe(48) and Fernet.generate_key().
AI_CONTEXT_JWT_SIGNING_KEY=
AI_CONTEXT_STORAGE_ENCRYPTION_KEY=
AI_CONTEXT_STATE_DIR=/state/oauth
